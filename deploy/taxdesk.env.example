# /etc/taxdesk/taxdesk.env
# Copy to /etc/taxdesk/taxdesk.env on guildenstern and `chmod 640`, root:ocelia.

TAXDESK_DB=/var/lib/taxdesk/taxdesk.db
TAXDESK_LOG=INFO

# API bind interface and port. Defaults to the Tailscale interface so the API
# is reachable across the tailnet but not exposed to the public internet or
# the LAN. Set TAXDESK_BIND_HOST=127.0.0.1 to keep it loopback-only (use with
# a reverse proxy). Set to 0.0.0.0 only if you know what you're doing.
TAXDESK_BIND_HOST=100.113.110.44
TAXDESK_BIND_PORT=8770

# Optional. Without a token, Socrata throttles harder but still works.
# Get one free at https://data.texas.gov by signing in and creating an app token.
SOCRATA_APP_TOKEN=

# Optional. Behold (https://behold.so) feed ID for the @barelysmash Instagram
# card on the Mixed Beverage view. Find this in the Behold dashboard under
# Embed Code. Leave blank to hide the card. Read at frontend build time, so
# rebuild after changing: cd /opt/taxdesk/web && npm run build
VITE_BEHOLD_FEED_ID=
