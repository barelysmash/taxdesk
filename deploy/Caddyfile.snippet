# /etc/caddy/Caddyfile snippet — add to your existing Caddy config.
# Replace taxdesk.example.com with whatever hostname you want.

taxdesk.example.com {
    encode zstd gzip

    # Serve built React assets
    root * /opt/taxdesk/web/dist
    file_server

    # SPA fallback so client-side routes work
    @notfile {
        not file
        not path /api/*
    }
    rewrite @notfile /index.html

    # API proxy
    handle /api/* {
        reverse_proxy 127.0.0.1:8770
    }

    log {
        output file /var/log/caddy/taxdesk.log
    }
}
